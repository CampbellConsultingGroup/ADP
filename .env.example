# ADP Environment Configuration
# Copy this file to .env and fill in the required values.

# ── Database ──────────────────────────────────────────────────────────────────
# Required. PostgreSQL async connection string.
# For Docker Compose: set POSTGRES_PASSWORD below; ADP_DATABASE_URL is built automatically.
POSTGRES_PASSWORD=change-me-in-production

# Override if using an external database:
# ADP_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/adp

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Required. API key for the configured LLM endpoint.
ADP_LLM_API_KEY=your-api-key-here

# LLM endpoint URL. Default: Anthropic Claude API.
ADP_LLM_ENDPOINT=https://api.anthropic.com

# Model to use for all AI operations.
# Anthropic: claude-sonnet-4-6 | claude-opus-4-8 | claude-haiku-4-5-20251001
ADP_LLM_MODEL=claude-sonnet-4-6

# ── Server ────────────────────────────────────────────────────────────────────
# Number of uvicorn worker processes. Increase for higher concurrency.
ADP_WORKERS=2

# Port the API server listens on.
ADP_PORT=8001

# ── Limits ────────────────────────────────────────────────────────────────────
# Maximum number of designs allowed in the system.
ADP_MAX_DESIGNS=1000

# ── Authentication (ADP-SPEC-026) ─────────────────────────────────────────────
# Set to false to disable auth (local development only).
ADP_AUTH_ENABLED=true

# Keycloak realm issuer URL. Must match the iss claim in JWTs.
ADP_KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/ADPRealm

# Keycloak client ID registered in the realm.
ADP_KEYCLOAK_CLIENT_ID=adp-frontend

# ── Business Architecture Export (ADP-SPEC-044) ───────────────────────────────
# Continuously exports business capabilities, value streams, stages, and
# domains to versioned JSON files. Unset (the default) disables the feature
# entirely -- no background task runs, nothing is written to disk.
# ADP_BUSINESS_ARCH_EXPORT_ROOT=/path/to/git-tracked/export/root

# How often (in seconds) the export reconciliation cycle runs. Only used when
# ADP_BUSINESS_ARCH_EXPORT_ROOT is set.
ADP_BUSINESS_ARCH_EXPORT_INTERVAL_SECONDS=60

# POST /api/v1/designs/{id}/export (ADP-SPEC-011) writes a complete export
# bundle (model.json/yaml, traceability, README, rendered diagrams) here.
# Deliberately a server-side setting, not a client-supplied request field
# (ADP-izw: the endpoint used to accept an arbitrary export_root string from
# the caller with no containment check at all). Unset means the endpoint
# returns 503 rather than silently writing nowhere -- unlike the background
# reconciliation features above, this is a synchronous, user-triggered
# action expecting a concrete result.
# ADP_DESIGN_EXPORT_ROOT=/path/to/git-tracked/export/root
