{
  "realm": "ADPRealm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyInitialCounter": 0,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": ["FreeOTP", "Google Authenticator"],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    }
  ],
  "groups": [
    { "name": "EnterpriseArchitect", "path": "/EnterpriseArchitect" },
    { "name": "ADPAdministrator", "path": "/ADPAdministrator" },
    { "name": "SolutionArchitect", "path": "/SolutionArchitect" },
    { "name": "TechnicalArchitect", "path": "/TechnicalArchitect" }
  ],
  "clients": [
    {
      "clientId": "adp-frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://adp-api.lemonrock-efb4b112.eastus2.azurecontainerapps.io/*"],
      "webOrigins": ["https://adp-api.lemonrock-efb4b112.eastus2.azurecontainerapps.io"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ]
}
