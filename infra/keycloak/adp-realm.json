{
  "realm": "ADPRealm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [
    { "name": "EnterpriseArchitect", "path": "/EnterpriseArchitect" },
    { "name": "ADPAdministrator", "path": "/ADPAdministrator" },
    { "name": "SolutionArchitect", "path": "/SolutionArchitect" },
    { "name": "TechnicalArchitect", "path": "/TechnicalArchitect" }
  ],
  "clients": [
    {
      "clientId": "adp-frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ]
}
